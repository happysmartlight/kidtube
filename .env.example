# Cổng và bind
PORT=8080
HOST=0.0.0.0

# Thư mục dữ liệu (map ra volume khi chạy Docker)
DATA_DIR=./data
MEDIA_DIR=./media

# PIN vào trang quản trị lần đầu — ĐỔI NGAY sau khi cài
DEFAULT_PIN=246813

# Bí mật ký cookie admin. Bỏ trống thì tự sinh (mất session khi restart).
# Sinh bằng: openssl rand -hex 32
SESSION_SECRET=

# YouTube Data API v3 — TUỲ CHỌN.
# Không có key vẫn chạy được (RSS + yt-dlp). Có key thì lấy được duration
# và toàn bộ lịch sử kênh chính xác hơn.
YT_API_KEY=

# Đường dẫn yt-dlp. Để trống/mặc định nếu đã có trong PATH.
YTDLP_PATH=yt-dlp

NODE_ENV=development
